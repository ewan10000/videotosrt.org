# Stripe bindings belong to the BACKEND Worker, not this frontend.
# Server/Worker bindings only. Never prefix Stripe secrets with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set true only after verifying DB is the same D1 used by api.videotosrt.org.
STRIPE_BILLING_SHARED_DB=false
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_STUDIO_MONTHLY_PRICE_ID=
STRIPE_STUDIO_YEARLY_PRICE_ID=
STRIPE_CREDITS_2H_PRICE_ID=
STRIPE_CREDITS_5H_PRICE_ID=
STRIPE_CREDITS_20H_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=

# Keep existing legacy bindings for existing subscribers and pending purchases.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_FORWARD_URL=
PAYPAL_MONTHLY_PLAN_ID=
PAYPAL_YEARLY_PLAN_ID=
PAYPAL_PRO_MONTHLY_PLAN_ID=
PAYPAL_PRO_YEARLY_PLAN_ID=
PAYPAL_STUDIO_MONTHLY_PLAN_ID=
PAYPAL_STUDIO_YEARLY_PLAN_ID=

# Live backend only; sandbox disables Managed Payments in its isolated harness.
STRIPE_REQUIRE_LIVE=true
STRIPE_MANAGED_PAYMENTS=true
